package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_binary {
    name: "maleicacid.tv.cas_plugin-stub-service",
    relative_install_path: "hw",
    vendor: true,
    crate_root: "src/main.rs",
    srcs: ["src/*.rs"],
    edition: "2021",
    init_rc: ["cas-plugin-stub-service.rc"],
    vintf_fragments: ["cas-plugin-stub-service.xml"],
    rustlibs: [
        "android.hardware.cas-V1-rust",
        "libbinder_rs",
    ],
}

rust_test {
    name: "maleicacid_cas_plugin_placeholder_test",
    vendor: true,
    crate_name: "maleicacid_cas_plugin_placeholder_test",
    crate_root: "src/main.rs",
    srcs: ["src/main.rs"],
    edition: "2021",
    rustlibs: [
        "android.hardware.cas-V1-rust",
        "libbinder_rs",
    ],
    auto_gen_config: true,
    test_suites: ["general-tests"],
}
