apex_key {
    name: "com.maleicacid.tv.tuner_hal.key",
    // 利用するツリーに存在する実鍵ファイルへ置き換える。
    public_key: "REPLACE_WITH_REAL_KEY.avbpubkey",
    private_key: "REPLACE_WITH_REAL_KEY.pem",
}

prebuilt_etc {
    name: "maleicacid_tuner_hal_apex_vintf_fragment",
    src: "tuner-hal-service.xml",
    filename: "tuner-hal-service.xml",
    sub_dir: "vintf",
}

prebuilt_etc {
    name: "maleicacid_tuner_hal_apex_init_rc",
    src: "apex_template/tuner-hal-service.apex.rc",
    filename: "tuner-hal-service.rc",
}

apex {
    name: "com.maleicacid.tv.tuner_hal",
    manifest: "apex_template/apex_manifest.json",
    file_contexts: "apex_template/file_contexts",
    vendor: true,
    updatable: true,
    binaries: [
        "maleicacid.tv.tuner_hal-service",
    ],
    prebuilts: [
        "maleicacid_tuner_hal_apex_vintf_fragment",
        "maleicacid_tuner_hal_apex_init_rc",
    ],
    key: "com.maleicacid.tv.tuner_hal.key",
    min_sdk_version: "apex_inherit",
}
