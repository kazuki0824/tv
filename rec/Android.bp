package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

filegroup {
    name: "maleicacid_rec_sources",
    srcs: ["src/**/*.kt"],
}


android_test {
    name: "MaleicacidRecScopeTests",
    srcs: [
        "tests/src/**/*.kt",
        "src/com/maleicacid/tvinput/db/TvInputDatabase.kt",
        "src/com/maleicacid/tvinput/reservation/ReservationPolicy.kt",
        "//vendor/maleicacid/tv/tis:maleicacid_tvinput_channel_keys_sources",
    ],
    manifest: "tests/AndroidManifest.xml",
    sdk_version: "system_current",
    static_libs: [
        "androidx.test.ext.junit",
        "androidx.test.runner",
    ],
    test_suites: ["device-tests"],
}
