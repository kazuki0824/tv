package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// PSI/SIの構文・意味解析を所有するcanonicalなpure-Rust core。
// Android JNIとhost側VTS adapterはいずれもこのlibraryをlinkし、独立したPAT/PMT parserを持たない。
rust_library {
    name: "libmaleicacid_arib_si_engine_core",
    crate_name: "maleicacid_arib_si_engine_core",
    crate_root: "src/core.rs",
    srcs: [
        "src/core.rs",
        "src/core/arib_jis_x0208_table.rs",
        "src/core/arib_extended_graphic_table.rs",
        "src/core/arib_jis_x0213_multiscalar.rs",
        "src/core/arib_string.rs",
        "src/core/ca_descriptor.rs",
        "src/core/descriptors.rs",
        "src/core/discovery_requirements.rs",
        "src/core/eit.rs",
        "src/core/eit_publish_policy.rs",
        "src/core/provider_data.rs",
        "src/core/sections.rs",
        "src/core/service_discovery.rs",
    ],
    edition: "2021",
    host_supported: true,
    rustlibs: [
        "libserde",
        "libserde_json",
    ],
}

rust_ffi_shared {
    name: "libmaleicacid_arib_si_engine_jni",
    crate_name: "maleicacid_arib_si_engine_jni",
    srcs: ["src/lib.rs"],
    edition: "2021",
    system_ext_specific: true,
    min_sdk_version: "31",
    rustlibs: [
        "libjni",
        "libserde",
        "libserde_json",
        "libmaleicacid_arib_si_engine_core",
    ],
}

rust_binary_host {
    name: "maleicacid_arib_si_engine_vts_host",
    crate_name: "maleicacid_arib_si_engine_vts_host",
    crate_root: "src/vts_profile_host.rs",
    srcs: ["src/vts_profile_host.rs"],
    edition: "2021",
    rustlibs: [
        "libserde_json",
        "libmaleicacid_arib_si_engine_core",
    ],
}

rust_test {
    name: "maleicacid_arib_si_engine_core_test",
    crate_name: "maleicacid_arib_si_engine_core_test",
    crate_root: "src/core.rs",
    srcs: [
        "src/core.rs",
        "src/core/arib_jis_x0208_table.rs",
        "src/core/arib_extended_graphic_table.rs",
        "src/core/arib_jis_x0213_multiscalar.rs",
        "src/core/arib_string.rs",
        "src/core/ca_descriptor.rs",
        "src/core/descriptors.rs",
        "src/core/discovery_requirements.rs",
        "src/core/eit.rs",
        "src/core/eit_publish_policy.rs",
        "src/core/provider_data.rs",
        "src/core/sections.rs",
        "src/core/service_discovery.rs",
    ],
    edition: "2021",
    rustlibs: [
        "libserde",
        "libserde_json",
    ],
    data: [
        "schema/channel_provider_data_v1.schema.json",
        "schema/descriptor_diagnostic_v1.schema.json",
        "schema/program_provider_data_v1.schema.json",
        "testdata/descriptor_diagnostic_v1/malformed_length.json",
        "testdata/program_provider_data_v1/minimal_clear_program.json",
        "testdata/program_provider_data_v1/unsupported_codec_program.json",
    ],
    auto_gen_config: true,
    test_suites: ["general-tests"],
}

rust_test {
    name: "maleicacid_arib_si_engine_rs_test",
    crate_name: "maleicacid_arib_si_engine_rs_test",
    srcs: ["src/lib.rs"],
    edition: "2021",
    rustlibs: [
        "libjni",
        "libserde",
        "libserde_json",
        "libmaleicacid_arib_si_engine_core",
    ],
    data: [
        "schema/channel_provider_data_v1.schema.json",
        "schema/descriptor_diagnostic_v1.schema.json",
        "schema/program_provider_data_v1.schema.json",
        "testdata/descriptor_diagnostic_v1/malformed_length.json",
        "testdata/program_provider_data_v1/minimal_clear_program.json",
        "testdata/program_provider_data_v1/unsupported_codec_program.json",
    ],
    auto_gen_config: true,
    test_suites: ["general-tests"],
}
