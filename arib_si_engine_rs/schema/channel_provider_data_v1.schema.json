{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maleicacid.local/schema/channel_provider_data_v1.schema.json",
  "title": "Maleicacid ChannelProviderDataV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "serviceKey",
    "tune",
    "cas",
    "diagnostics"
  ],
  "properties": {
    "schema": {
      "const": "maleicacid.tv.channel"
    },
    "schemaVersion": {
      "const": 1
    },
    "serviceKey": {
      "$ref": "#/$defs/serviceKey"
    },
    "tune": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayName",
        "deliverySystem",
        "frequencyHz",
        "streamId",
        "streamIdType"
      ],
      "properties": {
        "displayName": {
          "type": "string"
        },
        "deliverySystem": {
          "type": "string"
        },
        "frequencyHz": {
          "type": "integer",
          "minimum": 0
        },
        "streamId": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 65534
        },
        "streamIdType": {
          "type": "string",
          "enum": [
            "NONE",
            "TSID"
          ]
        },
        "physicalChannel": {
          "type": [
            "integer",
            "null"
          ]
        },
        "satelliteBand": {
          "type": [
            "string",
            "null"
          ]
        },
        "remoteControlKeyId": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "streamIdType": {
                "const": "NONE"
              }
            },
            "required": [
              "streamIdType"
            ]
          },
          "then": {
            "properties": {
              "streamId": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "streamIdType": {
                "const": "TSID"
              }
            },
            "required": [
              "streamIdType"
            ]
          },
          "then": {
            "properties": {
              "streamId": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65534
              }
            }
          }
        }
      ]
    },
    "cas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiresCas",
        "unsupportedCas",
        "clearLivePlaybackSupported"
      ],
      "properties": {
        "requiresCas": {
          "type": "boolean"
        },
        "unsupportedCas": {
          "type": "boolean"
        },
        "clearLivePlaybackSupported": {
          "type": "boolean"
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "channelRegistrationReady",
        "epgPublishable"
      ],
      "properties": {
        "channelRegistrationReady": {
          "type": "boolean"
        },
        "epgPublishable": {
          "type": "boolean"
        },
        "publishStateSource": {
          "type": "string"
        },
        "providerDataTruncated": {
          "type": "boolean"
        },
        "providerDataHardLimitBytes": {
          "type": "integer"
        },
        "providerDataSoftLimitBytes": {
          "type": "integer"
        },
        "rawProviderDataExtensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "value"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "value": {}
            }
          }
        },
        "providerDataDroppedCount": {
          "type": "integer",
          "minimum": 0
        },
        "providerDataTruncationCode": {
          "type": "string",
          "enum": [
            "PROVIDER_DATA_TRUNCATED",
            "DIAGNOSTICS_TRUNCATED"
          ]
        }
      }
    }
  },
  "$defs": {
    "uint16": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "serviceKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "originalNetworkId",
        "transportStreamId",
        "serviceId"
      ],
      "properties": {
        "originalNetworkId": {
          "$ref": "#/$defs/uint16"
        },
        "transportStreamId": {
          "$ref": "#/$defs/uint16"
        },
        "serviceId": {
          "$ref": "#/$defs/uint16"
        }
      }
    }
  }
}
