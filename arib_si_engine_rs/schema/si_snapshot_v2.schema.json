{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maleicacid.example/schema/si_snapshot_v2.schema.json",
  "title": "ARIB SI bulk snapshot v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "collectionGeneration",
    "ingestSequence",
    "discoveryStage",
    "broadcastClock",
    "tableRequirements",
    "catCaMetadata",
    "malformedCaDescriptorDiagnostics",
    "malformedCaDescriptorCounts",
    "transportSemanticFacts",
    "events",
    "eitInstances",
    "serviceSemanticFacts",
    "parserDiagnostics"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "collectionGeneration": {
      "type": "integer",
      "minimum": 0
    },
    "ingestSequence": {
      "type": "integer",
      "minimum": 0
    },
    "discoveryStage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "broadcastClock": {
      "anyOf": [
        {
          "$ref": "#/$defs/broadcastClock"
        },
        {
          "type": "null"
        }
      ]
    },
    "tableRequirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tableRequirement"
      }
    },
    "catCaMetadata": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/caMetadata"
      }
    },
    "malformedCaDescriptorDiagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/malformedCaDescriptorDiagnostic"
      }
    },
    "malformedCaDescriptorCounts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/malformedCaDescriptorCount"
      }
    },
    "transportSemanticFacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transportSemanticFacts"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "eitInstances": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/eitInstance"
      }
    },
    "serviceSemanticFacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/serviceSemanticFacts"
      }
    },
    "parserDiagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parserDiagnostic"
      }
    }
  },
  "$defs": {
    "serviceKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "originalNetworkId",
        "transportStreamId",
        "serviceId"
      ],
      "properties": {
        "originalNetworkId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "transportStreamId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "serviceId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "broadcastClock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tableId",
        "mjd",
        "millisOfDay"
      ],
      "properties": {
        "tableId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "mjd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "millisOfDay": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86399999
        }
      }
    },
    "tableRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "originalNetworkId",
        "transportStreamId",
        "serviceId",
        "required",
        "complete"
      ],
      "properties": {
        "component": {
          "type": "string"
        },
        "originalNetworkId": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            {
              "type": "null"
            }
          ]
        },
        "transportStreamId": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            {
              "type": "null"
            }
          ]
        },
        "serviceId": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            {
              "type": "null"
            }
          ]
        },
        "required": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean"
        }
      }
    },
    "caMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serviceKey",
        "caSystemId",
        "ecmPid",
        "emmPid",
        "elementaryPid",
        "privateDataHex",
        "source"
      ],
      "properties": {
        "serviceKey": {
          "anyOf": [
            {
              "$ref": "#/$defs/serviceKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "caSystemId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "ecmPid": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 8191
            },
            {
              "type": "null"
            }
          ]
        },
        "emmPid": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 8191
            },
            {
              "type": "null"
            }
          ]
        },
        "elementaryPid": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 8191
            },
            {
              "type": "null"
            }
          ]
        },
        "privateDataHex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})*$"
        },
        "source": {
          "type": "string",
          "enum": [
            "CAT",
            "PROGRAM",
            "ES"
          ]
        }
      }
    },
    "malformedCaDescriptorDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pid",
        "tableId",
        "tableIdExtension",
        "serviceId",
        "elementaryPid",
        "scope",
        "offset",
        "declaredLength",
        "actualRemainingLength",
        "reason",
        "rawPrefixHex"
      ],
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8191
        },
        "tableId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "tableIdExtension": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            {
              "type": "null"
            }
          ]
        },
        "serviceId": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            {
              "type": "null"
            }
          ]
        },
        "elementaryPid": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 8191
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "declaredLength": {
          "type": "integer",
          "minimum": 0
        },
        "actualRemainingLength": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string"
        },
        "rawPrefixHex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})*$"
        }
      }
    },
    "malformedCaDescriptorCount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serviceId",
        "count"
      ],
      "properties": {
        "serviceId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "transportSemanticFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "originalNetworkId",
        "transportStreamId",
        "networkName",
        "transportStreamName",
        "remoteControlKeyId",
        "sdtActual"
      ],
      "properties": {
        "originalNetworkId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "transportStreamId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "networkName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "transportStreamName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "remoteControlKeyId": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "sdtActual": {
          "type": "boolean"
        }
      }
    },
    "avc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileIdc",
        "constraintFlags",
        "levelIdc"
      ],
      "properties": {
        "profileIdc": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "constraintFlags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "levelIdc": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "audioHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audioObjectType",
        "samplingFrequency",
        "channelConfiguration",
        "extensionSamplingFrequency",
        "coreAudioObjectType",
        "channelCount"
      ],
      "properties": {
        "audioObjectType": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "samplingFrequency": {
          "type": "integer",
          "minimum": 0
        },
        "channelConfiguration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "extensionSamplingFrequency": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "coreAudioObjectType": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "channelCount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "audioExtension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileLevelIndications",
        "audioSpecificConfigHex",
        "header"
      ],
      "properties": {
        "profileLevelIndications": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "audioSpecificConfigHex": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{2})*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "header": {
          "anyOf": [
            {
              "$ref": "#/$defs/audioHeader"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "codecFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "avc",
        "mpeg4AudioProfileAndLevel",
        "audioExtension",
        "malformed",
        "rawDescriptorsHex"
      ],
      "properties": {
        "avc": {
          "anyOf": [
            {
              "$ref": "#/$defs/avc"
            },
            {
              "type": "null"
            }
          ]
        },
        "mpeg4AudioProfileAndLevel": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "audioExtension": {
          "anyOf": [
            {
              "$ref": "#/$defs/audioExtension"
            },
            {
              "type": "null"
            }
          ]
        },
        "malformed": {
          "type": "boolean"
        },
        "rawDescriptorsHex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})*$"
        }
      }
    },
    "elementaryStream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codecFacts",
        "codecProfileLevel",
        "codecSignalingResolved",
        "codec",
        "codecKind",
        "elementaryPid",
        "streamType",
        "componentTag",
        "componentType",
        "streamContent",
        "languageCodes",
        "dataComponentId",
        "captionDmf",
        "captionTiming",
        "automaticPresentationOnReception",
        "isCaption",
        "isSuperimpose"
      ],
      "properties": {
        "codecFacts": {
          "$ref": "#/$defs/codecFacts"
        },
        "codecProfileLevel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "codecSignalingResolved": {
          "type": "boolean"
        },
        "codec": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "codecKind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "VIDEO",
            "AUDIO",
            null
          ]
        },
        "elementaryPid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8191
        },
        "streamType": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "componentTag": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "componentType": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "streamContent": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "languageCodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dataComponentId": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            {
              "type": "null"
            }
          ]
        },
        "captionDmf": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "captionTiming": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "automaticPresentationOnReception": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "isCaption": {
          "type": "boolean"
        },
        "isSuperimpose": {
          "type": "boolean"
        }
      }
    },
    "serviceCaDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caSystemId",
        "caPid",
        "scope",
        "esPid",
        "rawDescriptorHex",
        "privateDataHex"
      ],
      "properties": {
        "caSystemId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "caPid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8191
        },
        "scope": {
          "type": "string",
          "enum": [
            "PROGRAM",
            "ES"
          ]
        },
        "esPid": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 8191
            },
            {
              "type": "null"
            }
          ]
        },
        "rawDescriptorHex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})*$"
        },
        "privateDataHex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})*$"
        }
      }
    },
    "smd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptorPresent",
        "syntaxValid",
        "systemManagementId",
        "broadcastingFlag",
        "broadcastingIdentifier",
        "broadcastSystem",
        "additionalBroadcastingIdentification",
        "additionalIdentificationInfoHex",
        "semanticState",
        "diagnostic"
      ],
      "properties": {
        "descriptorPresent": {
          "type": "boolean"
        },
        "syntaxValid": {
          "type": "boolean"
        },
        "systemManagementId": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            {
              "type": "null"
            }
          ]
        },
        "broadcastingFlag": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            {
              "type": "null"
            }
          ]
        },
        "broadcastingIdentifier": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            {
              "type": "null"
            }
          ]
        },
        "broadcastSystem": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "ISDB_T",
            "ISDB_S_BS",
            "ISDB_S_110CS",
            null
          ]
        },
        "additionalBroadcastingIdentification": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "additionalIdentificationInfoHex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})*$"
        },
        "semanticState": {
          "type": "string",
          "enum": [
            "SUPPORTED_BROADCAST",
            "NON_BROADCAST",
            "UNDEFINED_BROADCAST_CLASS",
            "UNSUPPORTED_BROADCAST_SYSTEM",
            "UNDETERMINED_SMD"
          ]
        },
        "diagnostic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "serviceSemanticFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "originalNetworkId",
        "transportStreamId",
        "serviceId",
        "serviceType",
        "pmtPidResolved",
        "pmtParsed",
        "pcrPidResolved",
        "elementaryStreams",
        "requiresCas",
        "casFactsCanonicalJson",
        "caDescriptorsResolved",
        "freeCaMode",
        "smd",
        "missingComponents",
        "semanticDiagnostics",
        "name",
        "providerName",
        "pmtPid",
        "pcrPid",
        "serviceScopedCaDescriptors"
      ],
      "properties": {
        "originalNetworkId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "transportStreamId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "serviceId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "serviceType": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "pmtPidResolved": {
          "type": "boolean"
        },
        "pmtParsed": {
          "type": "boolean"
        },
        "pcrPidResolved": {
          "type": "boolean"
        },
        "elementaryStreams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/elementaryStream"
          }
        },
        "requiresCas": {
          "type": "boolean"
        },
        "casFactsCanonicalJson": {
          "type": "string"
        },
        "caDescriptorsResolved": {
          "type": "boolean"
        },
        "freeCaMode": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "smd": {
          "$ref": "#/$defs/smd"
        },
        "missingComponents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "semanticDiagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "providerName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "pmtPid": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 8191
            },
            {
              "type": "null"
            }
          ]
        },
        "pcrPid": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 8191
            },
            {
              "type": "null"
            }
          ]
        },
        "serviceScopedCaDescriptors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/serviceCaDescriptor"
          }
        }
      }
    },
    "eitInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tableId",
        "originalNetworkId",
        "transportStreamId",
        "serviceId",
        "version",
        "currentNextIndicator",
        "lastSectionNumber",
        "receivedSections",
        "missingSections",
        "safeSections",
        "complete",
        "inconsistent"
      ],
      "properties": {
        "tableId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "originalNetworkId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "transportStreamId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "serviceId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "version": {
          "type": "integer",
          "minimum": 0,
