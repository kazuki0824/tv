{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maleicacid.local/schema/program_provider_data_v1.schema.json",
  "title": "Maleicacid ProgramProviderDataV1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "schemaVersion",
    "programKey",
    "timing",
    "source",
    "cas",
    "ratings",
    "genres",
    "series",
    "eventGroups",
    "linkage",
    "freeCaMode",
    "extendedItems",
    "components",
    "diagnostics"
  ],
  "properties": {
    "schema": {
      "const": "maleicacid.tv.program"
    },
    "schemaVersion": {
      "const": 1
    },
    "programKey": {
      "$ref": "#/$defs/programKey"
    },
    "timing": {
      "$ref": "#/$defs/timing"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "cas": {
      "$ref": "#/$defs/cas"
    },
    "ratings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rating"
      }
    },
    "genres": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/genre"
      }
    },
    "series": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/series"
        }
      ]
    },
    "eventGroups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/eventGroup"
      }
    },
    "linkage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/linkage"
      }
    },
    "freeCaMode": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/freeCaMode"
        }
      ]
    },
    "extendedItems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/extendedItem"
      }
    },
    "components": {
      "$ref": "#/$defs/components"
    },
    "diagnostics": {
      "$ref": "#/$defs/diagnostics"
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "audio"
        ]
      },
      {
        "required": [
          "video"
        ]
      }
    ]
  },
  "$defs": {
    "uint16": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "uint13": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8191
    },
    "uint8": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "hex": {
      "type": "string",
      "pattern": "^([0-9A-Fa-f]{2})*$"
    },
    "iso639": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3,
      "pattern": "^[A-Za-z]{3}$"
    },
    "parseStatus": {
      "type": "string",
      "minLength": 1
    },
    "programKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "originalNetworkId",
        "transportStreamId",
        "serviceId",
        "eventId"
      ],
      "properties": {
        "kind": {
          "const": "arib-event-v1"
        },
        "originalNetworkId": {
          "$ref": "#/$defs/uint16"
        },
        "transportStreamId": {
          "$ref": "#/$defs/uint16"
        },
        "serviceId": {
          "$ref": "#/$defs/uint16"
        },
        "eventId": {
          "$ref": "#/$defs/uint16"
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startUtcMillis",
        "durationMillis"
      ],
      "properties": {
        "startUtcMillis": {
          "type": "integer"
        },
        "durationMillis": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pid",
        "tableId",
        "version",
        "sectionNumber",
        "lastSectionNumber"
      ],
      "properties": {
        "pid": {
          "$ref": "#/$defs/uint13"
        },
        "tableId": {
          "$ref": "#/$defs/uint8"
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "sectionNumber": {
          "$ref": "#/$defs/uint8"
        },
        "lastSectionNumber": {
          "$ref": "#/$defs/uint8"
        }
      }
    },
    "cas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiresCas",
        "source"
      ],
      "properties": {
        "requiresCas": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "unsupportedCas"
            ]
          },
          {
            "required": [
              "clearLivePlaybackSupported"
            ]
          },
          {
            "required": [
              "channelRegistrationReady"
            ]
          },
          {
            "required": [
              "epgPublishable"
            ]
          },
          {
            "required": [
              "publishStateSource"
            ]
          }
        ]
      }
    },
    "rating": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "countryCode",
        "rawRatingByte",
        "parseStatus"
      ],
      "properties": {
        "countryCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "rawRatingByte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "parseStatus": {
          "$ref": "#/$defs/parseStatus"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "supported"
            ]
          },
          {
            "required": [
              "mappedTvContentRating"
            ]
          }
        ]
      }
    },
    "genre": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level1",
        "level2",
        "userNibble",
        "aribName",
        "parseStatus"
      ],
      "properties": {
        "level1": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "level2": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "userNibble": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "aribName": {
          "type": "string"
        },
        "parseStatus": {
          "$ref": "#/$defs/parseStatus"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "unmappedReason"
            ]
          },
          {
            "required": [
              "canonicalGenre"
            ]
          },
          {
            "required": [
              "mappedCanonicalGenre"
            ]
          }
        ]
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seriesId",
        "repeatLabel",
        "programPattern",
        "expireDateValid",
        "expireDate",
        "episodeNumber",
        "lastEpisodeNumber",
        "name",
        "parseStatus"
      ],
      "properties": {
        "seriesId": {
          "$ref": "#/$defs/uint16"
        },
        "repeatLabel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "programPattern": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "expireDateValid": {
          "type": "boolean"
        },
        "expireDate": {
          "anyOf": [
            {
              "$ref": "#/$defs/uint16"
            },
            {
              "type": "null"
            }
          ]
        },
        "episodeNumber": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "lastEpisodeNumber": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "parseStatus": {
          "$ref": "#/$defs/parseStatus"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "expireDateValid": {
                "const": true
              }
            },
            "required": [
              "expireDateValid"
            ]
          },
          "then": {
            "properties": {
              "expireDate": {
                "$ref": "#/$defs/uint16"
              }
            }
          },
          "else": {
            "properties": {
              "expireDate": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "linkage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transportStreamId",
        "originalNetworkId",
        "serviceId",
        "linkageType",
        "privateDataPrefixHex",
        "parseStatus"
      ],
      "properties": {
        "transportStreamId": {
          "$ref": "#/$defs/uint16"
        },
        "originalNetworkId": {
          "$ref": "#/$defs/uint16"
        },
        "serviceId": {
          "$ref": "#/$defs/uint16"
        },
        "linkageType": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "privateDataPrefixHex": {
          "$ref": "#/$defs/hex"
        },
        "parseStatus": {
          "$ref": "#/$defs/parseStatus"
        }
      }
    },
    "freeCaMode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw",
        "scrambled",
        "parseStatus"
      ],
      "properties": {
        "raw": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "scrambled": {
          "type": "boolean"
        },
        "parseStatus": {
          "$ref": "#/$defs/parseStatus"
        }
      }
    },
    "extendedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "languageCode",
        "description",
        "text",
        "parseStatus"
      ],
      "properties": {
        "languageCode": {
          "$ref": "#/$defs/iso639"
        },
        "parseStatus": {
          "$ref": "#/$defs/parseStatus"
        },
        "description": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "videoComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "esPid",
        "streamType",
        "componentTag",
        "componentType",
        "codec",
        "parseStatus"
      ],
      "properties": {
        "esPid": {
          "anyOf": [
            {
              "$ref": "#/$defs/uint13"
            },
            {
              "type": "null"
            }
          ]
        },
        "streamType": {
          "anyOf": [
            {
              "$ref": "#/$defs/uint8"
            },
            {
              "type": "null"
            }
          ]
        },
        "componentTag": {
          "anyOf": [
            {
              "$ref": "#/$defs/uint8"
            },
            {
              "type": "null"
            }
          ]
        },
        "componentType": {
          "anyOf": [
            {
              "$ref": "#/$defs/uint8"
            },
            {
              "type": "null"
            }
          ]
        },
        "codec": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "resolution": {
          "type": [
            "string",
            "null"
          ]
        },
        "scan": {
          "type": [
            "string",
            "null"
          ]
        },
        "aspect": {
          "type": [
            "string",
            "null"
          ]
        },
        "profileLevel": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceDescriptor": {
          "type": [
            "string",
            "null"
          ]
        },
        "parseStatus": {
          "$ref": "#/$defs/parseStatus"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "r51PlaybackSupported"
            ]
          },
          {
            "required": [
              "liveViewableClaim"
            ]
          }
        ]
      }
    },
    "audioComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "esPid",
        "streamType",
        "componentTag",
        "componentType",
        "codec",
        "language",
        "secondLanguage",
        "parseStatus"
      ],
      "properties": {
        "esPid": {
          "anyOf": [
            {
              "$ref": "#/$defs/uint13"
            },
            {
              "type": "null"
            }
          ]
        },
        "streamType": {
          "anyOf": [
            {
              "$ref": "#/$defs/uint8"
            },
            {
              "type": "null"
            }
          ]
        },
        "componentTag": {
          "anyOf": [
            {
              "$ref": "#/$defs/uint8"
            },
            {
              "type": "null"
            }
          ]
        },
        "componentType": {
          "anyOf": [
            {
              "$ref": "#/$defs/uint8"
            },
            {
              "type": "null"
            }
          ]
        },
        "codec": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "anyOf": [
            {
              "$ref": "#/$defs/iso639"
            },
            {
              "type": "null"
            }
          ]
        },
        "secondLanguage": {
          "anyOf": [
            {
              "$ref": "#/$defs/iso639"
            },
            {
              "type": "null"
            }
          ]
        },
        "channelConfiguration": {
          "type": [
            "string",
            "null"
          ]
        },
        "samplingInfo": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceDescriptor": {
          "type": [
            "string",
            "null"
          ]
        },
        "parseStatus": {
          "$ref": "#/$defs/parseStatus"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "r51PlaybackSupported"
            ]
          },
          {
            "required": [
              "liveViewableClaim"
            ]
          }
        ]
      }
    },
    "subtitleComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "esPid",
        "componentTag",
        "dataComponentId",
        "language",
        "captionServiceKind",
        "parseStatus"
      ],
      "properties": {
        "esPid": {
          "anyOf": [
            {
              "$ref": "#/$defs/uint13"
            },
            {
              "type": "null"
            }
          ]
        },
        "componentTag": {
          "anyOf": [
            {
              "$ref": "#/$defs/uint8"
            },
            {
              "type": "null"
            }
          ]
        },
        "dataComponentId": {
          "anyOf": [
            {
              "$ref": "#/$defs/uint16"
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "anyOf": [
            {
              "$ref": "#/$defs/iso639"
            },
            {
              "type": "null"
            }
          ]
        },
        "captionServiceKind": {
          "type": "string",
          "minLength": 1
        },
        "parseStatus": {
          "$ref": "#/$defs/parseStatus"
        }
      },
      "not": {
        "required": [
          "trackId"
        ]
      }
    },
    "dataComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "esPid",
        "componentTag",
        "dataComponentId",
        "componentType",
        "parseStatus"
      ],
      "properties": {
        "esPid": {
          "anyOf": [
            {
              "$ref": "#/$defs/uint13"
            },
            {
              "type": "null"
            }
          ]
        },
        "componentTag": {
          "anyOf": [
            {
              "$ref": "#/$defs/uint8"
            },
            {
              "type": "null"
            }
          ]
        },
        "dataComponentId": {
          "anyOf": [
            {
              "$ref": "#/$defs/uint16"
            },
            {
              "type": "null"
            }
          ]
        },
        "componentType": {
          "anyOf": [
            {
              "$ref": "#/$defs/uint8"
            },
            {
              "type": "null"
            }
          ]
        },
        "parseStatus": {
          "$ref": "#/$defs/parseStatus"
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "video",
        "audio",
        "subtitle",
        "data"
      ],
      "properties": {
        "video": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/videoComponent"
          }
        },
        "audio": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/audioComponent"
          }
        },
        "subtitle": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/subtitleComponent"
          }
        },
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dataComponent"
          }
        }
      }
    },
    "diagnosticItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptorDiagnostics",
        "publishDiagnostics",
        "parserDiagnostics"
      ],
      "properties": {
        "descriptorDiagnostics": {
          "type": "array",
          "items": {
            "$ref": "descriptor_diagnostic_v1.schema.json"
          }
        },
        "publishDiagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnosticItem"
          }
        },
        "parserDiagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnosticItem"
          }
        },
        "rawProviderDataExtensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "value"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "value": {}
            }
          }
        },
        "providerDataTruncated": {
          "type": "boolean"
        },
        "providerDataHardLimitBytes": {
          "type": "integer"
        },
        "providerDataSoftLimitBytes": {
          "type": "integer"
        },
        "providerDataDroppedCount": {
          "type": "integer",
          "minimum": 0
        },
        "providerDataDroppedCounts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "providerDataOriginalBytes": {
          "type": "integer",
          "minimum": 0
        },
        "providerDataFinalBytes": {
          "type": "integer",
          "minimum": 0
        },
        "providerDataTruncationCode": {
          "const": "PROVIDER_DATA_TRUNCATED"
        },
        "malformedCaDescriptorCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "not": {
        "required": [
          "currentProgram"
        ]
      }
    },
    "eventGroupReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serviceId",
        "eventId"
      ],
      "properties": {
        "serviceId": {
          "$ref": "#/$defs/uint16"
        },
        "eventId": {
          "$ref": "#/$defs/uint16"
        }
      }
    },
    "otherNetworkEventReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "originalNetworkId",
        "transportStreamId",
        "serviceId",
        "eventId"
      ],
      "properties": {
        "originalNetworkId": {
          "$ref": "#/$defs/uint16"
        },
        "transportStreamId": {
          "$ref": "#/$defs/uint16"
        },
        "serviceId": {
          "$ref": "#/$defs/uint16"
        },
        "eventId": {
          "$ref": "#/$defs/uint16"
        }
      }
    },
    "eventGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groupType",
        "events",
        "otherNetworkEvents",
        "privateDataHex",
        "parseStatus"
      ],
      "properties": {
        "groupType": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/eventGroupReference"
          }
        },
        "otherNetworkEvents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/otherNetworkEventReference"
          }
        },
        "privateDataHex": {
          "$ref": "#/$defs/hex"
        },
        "parseStatus": {
          "$ref": "#/$defs/parseStatus"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "groupType": {
                "enum": [
                  4,
                  5
                ]
              }
            },
            "required": [
              "groupType"
            ]
          },
          "then": {
            "properties": {
              "privateDataHex": {
                "const": ""
              }
            }
          },
          "else": {
            "properties": {
              "otherNetworkEvents": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
