+    /**
+     * Arms a one-shot callback for the first video frame that MediaSync successfully queues to
+     * its current output surface. The arm sequence is opaque to MediaSync and is returned unchanged
+     * with the callback so a platform-coupled client can reject a stale delayed event after re-arm.
+     *
+     * <p>This observes successful queueing to MediaSync's output surface. It does not indicate
+     * compositor presentation or present-fence completion.</p>
+     *
+     * @param armSequence positive identifier scoped by the caller to this MediaSync instance
+     * @param listener callback to arm, or {@code null} to disarm
+     * @param handler handler used to deliver the callback, or {@code null} for the current/main
+     *                looper
+     * @hide
+     */
+    public void setOnFirstVideoFrameQueuedToOutputListener(
+            long armSequence,
+            @Nullable OnFirstVideoFrameQueuedToOutputListener listener,
+            @Nullable Handler handler) {
+        if (listener != null && armSequence <= 0) {
+            throw new IllegalArgumentException("armSequence must be positive when armed");
+        }
+
+        synchronized (mOnFirstVideoFrameQueuedToOutputListenerLock) {
+            if (listener == null) {
+                mOnFirstVideoFrameQueuedToOutputListenerHandler = null;
+                mOnFirstVideoFrameQueuedToOutputListener = null;
+            } else {
+                if (handler != null) {
+                    mOnFirstVideoFrameQueuedToOutputListenerHandler = handler;
+                } else {
+                    Looper looper = Looper.myLooper();
+                    if (looper == null) {
+                        looper = Looper.getMainLooper();
+                    }
+                    mOnFirstVideoFrameQueuedToOutputListenerHandler =
+                            looper == null ? null : new Handler(looper);
+                }
+                mOnFirstVideoFrameQueuedToOutputListener = listener;
+            }
+        }
+
+        native_setFirstVideoFrameQueuedToOutputArm(listener != null, armSequence);
+    }
+
+    private void postFirstVideoFrameQueuedToOutputFromNative(long armSequence) {
+        final OnFirstVideoFrameQueuedToOutputListener listener;
+        final Handler handler;
+        synchronized (mOnFirstVideoFrameQueuedToOutputListenerLock) {
+            listener = mOnFirstVideoFrameQueuedToOutputListener;
+            handler = mOnFirstVideoFrameQueuedToOutputListenerHandler;
+        }
+        if (listener == null || handler == null) {
+            return;
+        }
+        final MediaSync sync = this;
+        handler.post(() -> listener.onFirstVideoFrameQueuedToOutput(sync, armSequence));
+    }
+
+    private native void native_setFirstVideoFrameQueuedToOutputArm(
+            boolean armed, long armSequence);
