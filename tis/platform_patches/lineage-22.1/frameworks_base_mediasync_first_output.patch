-JMediaSync::JMediaSync() {
+JMediaSync::JMediaSync(JNIEnv* env, jobject thiz)
+      : mJavaVm(nullptr),
+        mJavaObject(nullptr) {
+    CHECK_EQ(env->GetJavaVM(&mJavaVm), JNI_OK);
+    mJavaObject = env->NewWeakGlobalRef(thiz);
+    CHECK(mJavaObject != nullptr);
     mSync = MediaSync::create();
 }
 
 JMediaSync::~JMediaSync() {
+    mSync->setFirstVideoFrameQueuedToOutputCallback({});
+    if (mJavaObject == nullptr || mJavaVm == nullptr) {
+        return;
+    }
+
+    JNIEnv* env = nullptr;
+    bool attached = false;
+    if (mJavaVm->GetEnv(reinterpret_cast<void**>(&env), JNI_VERSION_1_6) != JNI_OK) {
+        if (mJavaVm->AttachCurrentThread(&env, nullptr) != JNI_OK) {
+            ALOGE("failed to attach JNI thread while releasing MediaSync callback");
+            return;
+        }
+        attached = true;
+    }
+    env->DeleteWeakGlobalRef(mJavaObject);
+    mJavaObject = nullptr;
+    if (attached) {
+        mJavaVm->DetachCurrentThread();
+    }
+}
+
+void JMediaSync::initializeFirstVideoFrameQueuedToOutputCallback() {
+    wp<JMediaSync> weakThis(this);
+    mSync->setFirstVideoFrameQueuedToOutputCallback(
+            [weakThis](int64_t armSequence) {
+                sp<JMediaSync> strongThis = weakThis.promote();
+                if (strongThis != nullptr) {
+                    strongThis->notifyFirstVideoFrameQueuedToOutput(armSequence);
+                }
+            });
+}
+
+void JMediaSync::setFirstVideoFrameQueuedToOutputArm(bool armed, int64_t armSequence) {
+    mSync->setFirstVideoFrameQueuedToOutputArm(armed, armSequence);
+}
+
+void JMediaSync::notifyFirstVideoFrameQueuedToOutput(int64_t armSequence) {
+    if (mJavaObject == nullptr || mJavaVm == nullptr) {
+        return;
+    }
+
+    JNIEnv* env = nullptr;
+    bool attached = false;
+    if (mJavaVm->GetEnv(reinterpret_cast<void**>(&env), JNI_VERSION_1_6) != JNI_OK) {
+        if (mJavaVm->AttachCurrentThread(&env, nullptr) != JNI_OK) {
+            ALOGE("failed to attach JNI thread for MediaSync first-output callback");
+            return;
+        }
+        attached = true;
+    }
+
+    jobject thiz = env->NewLocalRef(mJavaObject);
+    if (thiz != nullptr) {
+        env->CallVoidMethod(
+                thiz, gFields.postFirstVideoFrameQueuedToOutputID, static_cast<jlong>(armSequence));
+        if (env->ExceptionCheck()) {
+            ALOGE("exception delivering MediaSync first-output callback");
+            env->ExceptionDescribe();
+            env->ExceptionClear();
+        }
+        env->DeleteLocalRef(thiz);
+    }
+    if (attached) {
+        mJavaVm->DetachCurrentThread();
+    }
 }
 
