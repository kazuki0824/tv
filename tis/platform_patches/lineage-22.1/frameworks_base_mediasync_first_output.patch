+static void android_media_MediaSync_native_setFirstVideoFrameQueuedToOutputArm(
+        JNIEnv *env, jobject thiz, jboolean armed, jlong armSequence) {
+    sp<JMediaSync> sync = getMediaSync(env, thiz);
+    if (sync == NULL) {
+        // Disarm is part of release cleanup and remains harmless after native_release().
+        if (armed == JNI_FALSE) {
+            return;
+        }
+        throwExceptionAsNecessary(env, INVALID_OPERATION);
+        return;
+    }
+    if (armed == JNI_TRUE && armSequence <= 0) {
+        throwExceptionAsNecessary(env, BAD_VALUE, "armSequence must be positive when armed");
+        return;
+    }
+    sync->setFirstVideoFrameQueuedToOutputArm(armed == JNI_TRUE, armSequence);
+}
