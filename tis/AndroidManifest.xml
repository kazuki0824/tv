<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.maleicacid.tvinput">

    <uses-feature
        android:name="android.software.live_tv"
        android:required="true" />

    <uses-permission android:name="android.permission.ACCESS_TV_TUNER" />
    <uses-permission android:name="android.permission.ACCESS_TV_DESCRAMBLER" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_ROUTING" />
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="@string/app_name"
        android:directBootAware="true"
        android:usesCleartextTraffic="false">

        <service
            android:name=".tis.MaleicacidTvInputService"
            android:label="@string/input_label"
            android:permission="android.permission.BIND_TV_INPUT"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.tv.TvInputService" />
            </intent-filter>
            <meta-data
                android:name="android.media.tv.input"
                android:resource="@xml/maleicacid_tv_input" />
        </service>

        <service
            android:name=".aribsi.AribSiEngineService"
            android:exported="false"
            android:directBootAware="true" />

        <activity
            android:name=".tis.SetupActivity"
            android:exported="true"
            android:permission="android.permission.BIND_TV_INPUT"
            android:label="@string/setup_label" />

        <receiver
            android:name=".tis.EpgBootSyncReceiver"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
