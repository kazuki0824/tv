package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "MaleicacidTvInput",
    product_specific: true,
    privileged: true,

    manifest: "AndroidManifest.xml",
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],

    sdk_version: "system_current",
    min_sdk_version: "31",
    certificate: "platform",

    jni_libs: [
        "libmaleicacid_arib_si_engine_jni",
    ],

    required: [
        "privapp-permissions-maleicacid-tvinput",
    ],

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
}

prebuilt_etc {
    name: "privapp-permissions-maleicacid-tvinput",
    product_specific: true,
    src: "permissions/privapp-permissions-maleicacid-tvinput.xml",
    sub_dir: "permissions",
    filename: "privapp-permissions-maleicacid-tvinput.xml",
}

android_test {
    name: "MaleicacidTvInputAcceptanceTests",
    product_specific: true,
    srcs: ["tests/src/**/*.kt"],
    manifest: "tests/AndroidManifest.xml",
    sdk_version: "system_current",
    min_sdk_version: "31",
    certificate: "platform",
    instrumentation_for: "MaleicacidTvInput",
    static_libs: [
        "androidx.test.ext.junit",
        "androidx.test.runner",
    ],
    test_suites: ["device-tests"],
}
