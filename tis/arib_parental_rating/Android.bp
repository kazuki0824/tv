package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// AOSP TIF標準のrating-system providerとしてTV Appから発見されるproduct extension。
android_app {
    name: "AribContentRatings",
    product_specific: true,
    manifest: "AndroidManifest.xml",
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    sdk_version: "current",
    min_sdk_version: "31",
}
