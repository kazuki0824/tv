package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "maleicacid_tuner_hal2_vts_resolver",
    vendor: true,
    srcs: [
        "main.cpp",
        "psi_parser.cpp",
    ],
    cflags: ["-Wall", "-Wextra", "-Werror", "-std=c++20"],
    shared_libs: [
        "libbinder_ndk",
        "libfmq",
        "libutils",
        "android.hardware.tv.tuner-V2-ndk",
        "android.hardware.common-V2-ndk",
        "android.hardware.common.fmq-V1-ndk",
    ],
}

cc_test_host {
    name: "maleicacid_tuner_hal2_psi_parser_test",
    srcs: [
        "psi_parser.cpp",
        "psi_parser_test.cpp",
    ],
    cflags: ["-Wall", "-Wextra", "-Werror", "-std=c++20"],
    static_libs: ["libgtest", "libgtest_main"],
}
