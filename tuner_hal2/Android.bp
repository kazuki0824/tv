package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// external/rust/android-crates-io で libloom が供給される環境だけで使う任意defaults。
// 通常testには適用しない。loom対象testを追加するときに defaults に指定する。
rust_defaults {
    name: "maleicacid_tuner_hal2_loom_test_defaults",
    rustlibs: ["libloom"],
    cfgs: ["loom"],
}

prebuilt_etc {
    name: "maleicacid_tuner_hal2_ueventd_rc",
    vendor: true,
    src: "config/ueventd.tuner_hal2.rc",
    filename: "ueventd.tuner_hal2.rc",
}


cc_library_shared {
    name: "libmaleicacid_tuner_hal2_fmq_shim",
    vendor: true,
    srcs: ["fmq_shim/src/tuner_fmq_shim.cpp"],
    export_include_dirs: ["fmq_shim/include"],
    shared_libs: [
        "libfmq",
        "libutils",
        "libcutils",
        "libbase",
        "libc++",
        "libdmabufheap",
        "libhardware",
        "android.hardware.common.fmq-V1-ndk",
        "android.hardware.common-V2-ndk",
    ],
    cflags: ["-std=c++20"],
}

rust_library {
    name: "libmaleicacid_tuner_hal2_common",
    vendor: true,
    crate_name: "maleicacid_tuner_hal2_common",
    crate_root: "common/src/lib.rs",
    srcs: [
        "common/src/lib.rs",
        "common/src/os_abi.rs",
    ],
    edition: "2021",
}

rust_library {
    name: "libmaleicacid_tuner_hal2_control_core",
    vendor: true,
    crate_name: "maleicacid_tuner_hal2_control_core",
    srcs: ["control/src/lib.rs"],
    edition: "2021",
    rustlibs: ["libmaleicacid_tuner_hal2_common"],
}

rust_library {
    name: "libmaleicacid_tuner_hal2_fmq",
    vendor: true,
    crate_name: "maleicacid_tuner_hal2_fmq",
    srcs: ["fmq/src/lib.rs"],
    edition: "2021",
    shared_libs: ["libmaleicacid_tuner_hal2_fmq_shim"],
}

rust_library {
    name: "libmaleicacid_tuner_hal2_device",
    vendor: true,
    crate_name: "maleicacid_tuner_hal2_device",
    crate_root: "device/src/lib.rs",
    srcs: [
        "device/src/lib.rs",
        "device/src/dvb/mod.rs",
        "device/src/dvb/abi.rs",
        "device/src/dvb/tune_mapping.rs",
